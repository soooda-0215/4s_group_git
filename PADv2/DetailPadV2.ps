%!PS-Adobe-1.0
% pad2ps PostScript output
%   S. Yoshida (seiichi@muraoka.info.waseda.ac.jp)
%
%
clippath pathbbox
/page-height exch def
/page-width exch def
pop pop
%
/move2show {
   moveto show
} def
%
% PAD line -- usage: x0 y0 w h line
/line {
   neg 4 -2 roll moveto rlineto
} def
%
% PAD box -- usage: x0 y0 w h box
/box {
   4 -2 roll moveto
   dup neg 0 exch rlineto
   exch dup 0 rlineto
   exch dup 0 exch rlineto
   pop pop
   closepath
} def
%
% PAD circle -- usage: x0 y0 w h circle
/circle {
   dup 3 -1 roll dup 3 -1 roll 6 -1 roll dup 7 -1 roll dup
   8 -1 roll 2 idiv sub 3 -1 roll 7 -1 roll add
   exch moveto
   4 -2 roll dup 3 -1 roll dup 3 1 roll
   div dup dup 7 2 roll 1 exch scale
   dup 5 1 roll
   3 1 roll 2 idiv sub 5 -1 roll div
   3 1 roll 2 idiv add
   exch 3 -1 roll 2 idiv 0 360 arc
   1 exch div 1 exch scale
} def
%
% PAD ifline -- usage: x0 y0 w h ifline
/ifline {
   4 -2 roll moveto
   dup neg 0 exch rlineto
   exch dup 0 rlineto
   exch dup 2 idiv dup -200 exch rlineto
   sub 200 exch rlineto
   pop
} def
%
% PAD ifbox -- usage: x0 y0 w h ifbox
/ifbox {
   ifline closepath
} def
%
/clippingpath {
   newpath
   0 9800 moveto
   0 0 lineto
   9000 0 lineto
   9000 9800 lineto
   closepath
} def
%
/pageframe {
   8 setlinewidth
   newpath
   0 9800 moveto
   0 0 lineto
   9000 0 lineto
   9000 9800 lineto
   closepath stroke
} def
